# ============================================================================
# Legal Services Agents — Environment Configuration
# ============================================================================
# Copy to .env and fill in your values:  cp .env.example .env
# Load into shell:                       set -a && source .env && set +a
# ============================================================================

# --- Authentication (Anthropic API) ---
ANTHROPIC_API_KEY=your-api-key
CLAUDE_CODE_USE_BEDROCK=0

# --- Authentication (Bedrock) ---
# The Agent SDK uses Claude Code CLI under the hood. Set this to route via Bedrock.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Model ---
# Bedrock model IDs use the full provider-prefixed format
CLAUDE_MODEL=us.anthropic.claude-opus-4-6-v1

# --- Agent behavior ---
MAX_TURNS=50
MAX_HANDOFF_DEPTH=3

# --- Extended thinking (Opus 4+) ---
THINKING_ENABLED=false
THINKING_BUDGET=10000

# --- Retry / timeout (SDK CLI handles retries internally) ---
# CLAUDE_CODE_MAX_RETRIES=3
# API_TIMEOUT_MS=600000

# --- Orchestrator ---
# on  = auto-execute (skip confirmation)
# off = show plan and ask before dispatching
ACCEPT_EDIT=off

# --- API Server (for web frontend) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
SESSION_TTL_MINUTES=30

# --- Frontend ---
# Set in frontend/.env.local if the backend runs on a different host/port
# PYTHON_BACKEND_URL=http://localhost:8000

# ============================================================================
# MCP Servers
# ============================================================================
# Optional — agents degrade gracefully if not configured.
# Uncomment the servers you need.
#
# Values with special chars (parentheses, spaces) MUST be quoted.
# Format for subprocess env vars: MCP_<SERVER>_ENV="KEY=value"
#
# Transports:
#   stdio  → local process (MCP_*_COMMAND + MCP_*_ARGS)
#   sse    → remote SSE    (MCP_*_URL + MCP_*_HEADERS)
#   http   → remote HTTP   (MCP_*_URL + MCP_*_HEADERS)
# ============================================================================

# --- Legal Research ---

# CourtListener (free, PACER integration available) — docket search, opinions
# Get API key: https://www.courtlistener.com/help/api/
# MCP_COURTLISTENER_TRANSPORT=stdio
# MCP_COURTLISTENER_COMMAND=uvx
# MCP_COURTLISTENER_ARGS=courtlistener-mcp
# MCP_COURTLISTENER_ENV="COURTLISTENER_API_KEY=YOUR_KEY"

# --- Contract & Document Management ---

# Ironclad (CLM) — contract lifecycle management
# MCP_IRONCLAD_TRANSPORT=sse
# MCP_IRONCLAD_URL=https://your-instance.ironcladapp.com/mcp
# MCP_IRONCLAD_HEADERS="Authorization=Bearer YOUR_TOKEN"

# iManage (DMS) — document management
# MCP_IMANAGE_TRANSPORT=sse
# MCP_IMANAGE_URL=https://your-instance.imanage.work/mcp
# MCP_IMANAGE_HEADERS="Authorization=Bearer YOUR_TOKEN"

# --- Regulatory & Compliance ---

# SEC EDGAR (free, no API key) — filings, XBRL financials, section extraction
# Install: uvx sec-edgar-mcp
# MCP_EDGAR_TRANSPORT=stdio
# MCP_EDGAR_COMMAND=uvx
# MCP_EDGAR_ARGS=sec-edgar-mcp
# MCP_EDGAR_ENV="SEC_EDGAR_USER_AGENT=YourName (your@email.com)"
# SEC_EDGAR_USER_AGENT="YourName (your@email.com)"

# --- Sanctions & Screening ---

# OpenSanctions (free tier available) — PEP/sanctions screening across 320+ lists
# Get free key: https://www.opensanctions.org/api/
# MCP_SANCTIONS_TRANSPORT=stdio
# MCP_SANCTIONS_COMMAND=npx
# MCP_SANCTIONS_ARGS=-y,opensanctions-mcp
# MCP_SANCTIONS_ENV="OPENSANCTIONS_API_KEY=YOUR_KEY"

# --- Productivity ---

# Google Drive — document storage for contract uploads
# MCP_GDRIVE_TRANSPORT=stdio
# MCP_GDRIVE_COMMAND=uvx
# MCP_GDRIVE_ARGS=google-drive-mcp

# Slack — alerts and notifications from scheduled agents
# MCP_SLACK_TRANSPORT=stdio
# MCP_SLACK_COMMAND=uvx
# MCP_SLACK_ARGS=slack-mcp
# MCP_SLACK_ENV="SLACK_BOT_TOKEN=xoxb-YOUR_TOKEN"

# --- News & Monitoring ---

# Google News & Trends (free, no API key) — regulatory news monitoring
# Install: uvx google-news-trends-mcp
# MCP_NEWS_TRANSPORT=stdio
# MCP_NEWS_COMMAND=uvx
# MCP_NEWS_ARGS=google-news-trends-mcp
