# ============================================================================
# Legal Services Platform — Environment Configuration
# ============================================================================
# Copy to .env and fill in your values:  cp .env.example .env
# Load into shell:                       set -a && source .env && set +a
# ============================================================================

# --- Authentication (Anthropic API) ---
ANTHROPIC_API_KEY=your-api-key

# --- Authentication (Bedrock) ---
# The Agent SDK uses Claude Code CLI under the hood. Set this to route via Bedrock.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Model ---
# Bedrock model IDs use the full provider-prefixed format
CLAUDE_MODEL=us.anthropic.claude-opus-4-6-v1

# --- Agent behavior ---
MAX_TURNS=50
MAX_HANDOFF_DEPTH=3

# --- Extended thinking (Opus 4+) ---
THINKING_ENABLED=false
THINKING_BUDGET=10000

# --- Orchestrator ---
# on  = auto-execute (skip confirmation)
# off = show plan and ask before dispatching
ACCEPT_EDIT=off

# --- API Server (FastAPI backend) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
SESSION_TTL_MINUTES=30

# --- Frontend (Next.js) ---
# Set in frontend/.env.local if the backend runs on a different host/port
# PYTHON_BACKEND_URL=http://localhost:8000

# --- Profiles ---
# Directory where agent practice profiles are stored after configuration
# PROFILES_DIR=./sandbox/profiles

# ============================================================================
# MCP Server Tokens (optional — agents work without them)
# ============================================================================
# The backend connects to external MCP servers for legal research, document
# management, and other integrations. Set tokens for services you have access to.
#
# See mcp_servers/registry.py for the full server configuration.
# ============================================================================

# --- Contract & Document Management ---
# IRONCLAD_TOKEN=
# DOCUSIGN_TOKEN=
# DEFINELY_TOKEN=
# IMANAGE_TOKEN=
# BOX_TOKEN=

# --- E-Discovery & Litigation ---
# EVERLAW_TOKEN=
# AURORA_TOKEN=

# --- Legal Research ---
# SOLVE_TOKEN=
