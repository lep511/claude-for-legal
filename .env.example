# ============================================================================
# Legal Services Agents — Environment Configuration
# ============================================================================
# Copy to .env and fill in your values:  cp .env.example .env
# Load into shell:                       set -a && source .env && set +a
# ============================================================================

# --- Authentication (Anthropic API) ---
ANTHROPIC_API_KEY=your-api-key
CLAUDE_CODE_USE_BEDROCK=0

# --- Authentication (Bedrock) ---
# The Agent SDK uses Claude Code CLI under the hood. Set this to route via Bedrock.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Model ---
# Bedrock model IDs use the full provider-prefixed format
CLAUDE_MODEL=us.anthropic.claude-opus-4-6-v1

# --- Agent behavior ---
MAX_TURNS=50
MAX_HANDOFF_DEPTH=3

# --- Extended thinking (Opus 4+) ---
THINKING_ENABLED=false
THINKING_BUDGET=10000

# --- Retry / timeout (SDK CLI handles retries internally) ---
# CLAUDE_CODE_MAX_RETRIES=3
# API_TIMEOUT_MS=600000

# --- Orchestrator ---
# on  = auto-execute (skip confirmation)
# off = show plan and ask before dispatching
ACCEPT_EDIT=off

# --- API Server (for web frontend) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:35428
SESSION_TTL_MINUTES=30

# --- Frontend ---
# Set in frontend/.env.local if the backend runs on a different host/port
# PYTHON_BACKEND_URL=http://localhost:8000

# ============================================================================
# MCP Server Tokens (optional — agents work without them)
# ============================================================================
# The backend connects to 19 remote MCP servers (same as Claude Code/Cowork).
# Servers without a token below use OAuth via the Claude Code CLI session.
# Set tokens only if you have service-level API access to that platform.
#
# See mcp_servers/MCP-INFO.md for the full server inventory.
# ============================================================================

# --- Contract & Document Management ---
# IRONCLAD_TOKEN=
# DOCUSIGN_TOKEN=
# DEFINELY_TOKEN=
# IMANAGE_TOKEN=
# BOX_TOKEN=

# --- E-Discovery & Litigation ---
# EVERLAW_TOKEN=
# AURORA_TOKEN=

# --- Legal Research ---
# SOLVE_TOKEN=
